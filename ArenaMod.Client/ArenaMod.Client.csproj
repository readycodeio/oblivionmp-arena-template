<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <!-- The in-game SDK. It brings the shared package and the source generator with it. -->
    <ItemGroup>
        <PackageReference Include="ReadyM.SDK.Oblivion.Client" Version="1.0.0-rc.3" />
    </ItemGroup>

    <!-- The chat mod's client API. Chat is a dependency in manifest.json, so it is loaded first and provides
         IChat; its assemblies stay out of this mod's folder. -->
    <ItemGroup>
        <PackageReference Include="ReadyM.Oblivion.Chat.Client" Version="1.0.0-rc.3" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\ArenaMod.Common\ArenaMod.Common.csproj" />
    </ItemGroup>

</Project>
