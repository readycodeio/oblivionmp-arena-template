<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <!-- Shared code for both halves, so it may only use assemblies both hosts provide. These are
         byte-identical in Dependencies/Client and Dependencies/Server; Client is just the one we
         point at. Private=false: the host provides them at runtime. -->
    <ItemGroup>
        <Reference Include="..\Dependencies\Client\ReadyM.Api.dll">
            <Private>false</Private>
        </Reference>
        <Reference Include="..\Dependencies\Client\ReadyM.Api.Multiplayer.dll">
            <Private>false</Private>
        </Reference>
        <!-- The SDK attributes: [RpcContracts], [Archetype], [Mixin] and the rest. Every project
             that carries one needs this, because the generator writes its registrations against it. -->
        <Reference Include="..\Dependencies\Client\ReadyM.SDK.dll">
            <Private>false</Private>
        </Reference>
        <!-- Oblivion archetypes and shapes shared by both halves, e.g. Player and Actor. -->
        <Reference Include="..\Dependencies\Client\OblivionMp.Sdk.Common.dll">
            <Private>false</Private>
        </Reference>
        <!-- Oblivion-specific values shared with the server. -->
        <Reference Include="..\Dependencies\Client\ReadyM.Relay.Common.Oblivion.dll">
            <Private>false</Private>
        </Reference>
        <Reference Include="..\Dependencies\Client\Friflo.Engine.ECS.dll">
            <Private>false</Private>
        </Reference>
        <Analyzer Include="..\Dependencies\Client\ReadyM.Api.Generators.dll" />
    </ItemGroup>

    <!-- Generated RPC serialization uses LiteNetLib's readers and writers. ExcludeAssets keeps it
         out of the build output: the host loads its own copy. -->
    <ItemGroup>
        <PackageReference Include="LiteNetLib" Version="1.3.5" ExcludeAssets="runtime" />
    </ItemGroup>

</Project>
